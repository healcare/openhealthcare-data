{
  "name": "openhealthcare-data",
  "private": true,
  "version": "1.2.0",
  "description": "Source-linked research bundles for OpenHealthcare.org",
  "type": "module",
  "scripts": {
    "validate-data": "node scripts/validate-bundles.mjs && node scripts/validate-profile-artifacts.mjs",
    "test:refresh": "node scripts/test-profile-refresh.mjs",
